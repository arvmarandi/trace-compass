# ============================================================
# Shared pipeline configuration
# Both mini-swe-agent and kgCompass read from this file.
# ============================================================

# Backbone LLM — use litellm format (provider/model).
# mini-swe-agent uses this directly.
# kgCompass strips the provider prefix automatically.
MODEL=deepseek/deepseek-chat

# SWE-bench subset to run against: "verified", "lite", or "full"
SUBSET=verified

# API keys
DEEPSEEK_API_KEY=
GITHUB_TOKEN=

# Neo4j connection (used by kgCompass)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# Parallelism for batch runs (number of instances to run concurrently)
PARALLEL=1
